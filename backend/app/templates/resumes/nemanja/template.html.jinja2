<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ resume.contact.name }}</title>
<style>
  /* Page margins live here, not in body padding: a body's own padding is
     only ever applied ONCE around the whole (possibly multi-page) flow,
     so every internal page break would otherwise render with ZERO top
     spacing - a heading landing right after a break would sit flush
     against the physical page edge. @page repeats on every page instead.
     Page 1 keeps a normal top margin; every later page (where a section/
     job spilling over is most likely to land right at the top) gets a
     noticeably bigger one so it never looks cramped. */
  @page { margin: 90px 50px 40px 50px; }
  @page :first { margin-top: 40px; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 0;
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    color: #1a1a1a;
    font-size: 10.5pt;
    line-height: 1.45;
    text-align: left;
  }
  .header { text-align: center; margin-bottom: 10px; }
  h1.name { margin: 0; font-size: 21pt; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; }
  p.title { margin: 2px 0 6px; font-size: 11.5pt; color: #333; }
  p.contact { margin: 0; font-size: 9.5pt; color: #444; }
  p.contact span:not(:last-child)::after { content: "   \2022   "; color: #999; }
  hr.rule { border: none; border-top: 1px solid #999; margin: 12px 0 6px; }
  h2.section { margin: 0 0 6px; font-size: 11pt; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  p.summary { margin: 0 0 4px; color: #333; }
  p.skills-line { margin: 0; color: #333; }
  .edu-row { display: flex; justify-content: space-between; gap: 12px; }
  .edu-degree { margin: 2px 0 0; font-weight: 700; }
  .job { margin-bottom: 12px; }
  .job:last-child { margin-bottom: 0; }
  table.job-header { width: 100%; border-collapse: collapse; }
  table.job-header td { padding: 0; vertical-align: baseline; }
  .job-company { font-weight: 700; }
  .job-dates { color: #666; white-space: nowrap; text-align: right; }
  .job-title { margin: 2px 0 0; font-weight: 700; }
{% include "_job_duties.css.jinja2" %}
  ul.plain { margin: 4px 0 0; padding-left: 18px; }
  ul.plain li { margin: 2px 0; color: #333; }
  section.block { margin-top: 14px; }
  /* Page-break hygiene. Deliberately NOT "break-inside: avoid" on the
     whole .job block - forcing an entire multi-bullet job to move as one
     unit means the ENTIRE job jumps to the next page the instant it
     doesn't fully fit in whatever space is left, wasting that leftover
     space as a large blank gap. Letting a job's bullet list split
     naturally (like a normal paragraph/list) fills the page properly;
     only the job's header is kept glued to its first bullet (never
     stranded alone with nothing under it), and a single bullet's own
     text is never split mid-sentence. */
  h2.section { break-after: avoid; page-break-after: avoid; }
  .job-title { break-after: avoid; page-break-after: avoid; }
  p.job-duty, ul.plain li { break-inside: avoid; page-break-inside: avoid; }
  p, li { orphans: 3; widows: 3; }
</style>
</head>
<body>
  <div class="header">
    <h1 class="name">{{ resume.contact.name }}</h1>
    {% if resume.experience %}<p class="title">{{ resume.experience[0].title }}</p>{% endif %}
    <p class="contact">
      {% if resume.contact.phone %}<span>{{ resume.contact.phone }}</span>{% endif %}
      {% if resume.contact.email %}<span>{{ resume.contact.email }}</span>{% endif %}
      {% if resume.contact.location %}<span>{{ resume.contact.location }}</span>{% endif %}
    </p>
  </div>

  {% if resume.summary %}
  <section class="block">
    <hr class="rule" />
    <h2 class="section">Summary</h2>
    <p class="summary">{{ resume.summary }}</p>
  </section>
  {% endif %}

  {% set all_skills = resume.skills.languages + resume.skills.backend + resume.skills.frontend + resume.skills.cloud + resume.skills.devops + resume.skills.databases + resume.skills.ai + resume.skills.tools %}
  {% if all_skills %}
  <section class="block">
    <hr class="rule" />
    <h2 class="section">Skills</h2>
    <p class="skills-line">{{ all_skills | join(", ") }}</p>
  </section>
  {% endif %}

  {% if resume.education %}
  <section class="block">
    <hr class="rule" />
    <h2 class="section">Education</h2>
    {% for edu in resume.education %}
    <div class="edu-row">
      <span>{{ edu.institution }}{% if edu.institution and edu.dates %} | {% endif %}{{ edu.dates }}</span>
    </div>
    <p class="edu-degree">{{ edu.degree }}</p>
    {% endfor %}
  </section>
  {% endif %}

  {% if resume.experience %}
  <section class="block">
    <hr class="rule" />
    <h2 class="section">Work Experience</h2>
    {% for job in resume.experience %}
    <div class="job">
      <table class="job-header">
        <tr>
          <td class="job-company">{{ job.company }}</td>
          <td class="job-dates">{{ job.dates }}</td>
        </tr>
      </table>
      <p class="job-title">{{ job.title }}</p>
      {% include "_job_duties.html.jinja2" %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if resume.certifications %}
  <section class="block">
    <hr class="rule" />
    <h2 class="section">Certifications</h2>
    <ul class="plain">{% for line in resume.certifications %}<li>{{ line }}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if resume.languages %}
  <section class="block">
    <hr class="rule" />
    <h2 class="section">Languages</h2>
    <ul class="plain">{% for line in resume.languages %}<li>{{ line }}</li>{% endfor %}</ul>
  </section>
  {% endif %}
</body>
</html>
