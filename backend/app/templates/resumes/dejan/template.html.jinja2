<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>{{ resume.contact.name }}</title>
<style>
  /* Top margin is 0 here on purpose - the accent bar + its own repeating
     "table thead" wrapper below fully own top spacing instead (see the
     .page-wrap comment). @page still owns bottom/left/right, which have
     no such conflict. */
  @page { margin: 0 48px 48px 48px; }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 0;
    font-family: "Segoe UI", Arial, Helvetica, sans-serif;
    color: #262626;
    font-size: 10.5pt;
    line-height: 1.45;
  }
  /* This template's green accent bar needs to repeat identically at the
     true top of every physical page, not just page 1 - normally a
     "position: fixed" element (which Chromium repeats on every printed
     page). But in this Chromium build, ANY "position: fixed" element on
     a paginated document silently collapses the page's top margin/
     padding back to ~0 on every page AFTER the first (confirmed with
     both Playwright's page.pdf() margin option and a CSS "@page"
     margin, and regardless of whether that margin is the same or
     different across pages) - so the first line of content on page 2+
     lands underneath/through the bar instead of below it.
     A "<table><thead>" IS reliably repeated by Chromium's print engine
     on every page (the standard, well-supported technique for a
     multi-page PDF's repeating header row) without this bug, so the bar
     lives in a one-row <thead> and the rest of the resume lives in a
     single <tbody> cell below it - see the body markup. */
  table.page-wrap { width: 100%; border-collapse: collapse; }
  thead .bar-cell { padding: 0; }
  .accent-bar { height: 10px; background: #3a9d51; }
  /* 26px = the original 36px top margin minus the bar's own 10px height -
     reproduces the exact page-1 gap between bar and name on every page. */
  tbody .content-cell { padding: 26px 0 0; }
  h1.name { margin: 18px 0 2px; font-size: 24pt; font-weight: 700; color: #262626; }
  .title { margin: 0 0 8px; font-size: 12.5pt; font-weight: 700; color: #3a9d51; }
  .contact { margin: 0 0 18px; font-size: 9pt; color: #8a8a8a; }
  .contact span:not(:last-child)::after { content: " \00b7 "; color: #c7c7c7; }
  h2.section {
    margin: 18px 0 6px;
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #3a9d51;
  }
  p.summary { margin: 0; color: #444; }
  p.skills-line { margin: 0; color: #444; }
  .job { margin-bottom: 14px; }
  .job:last-child { margin-bottom: 0; }
  table.job-header { width: 100%; border-collapse: collapse; }
  table.job-header td { padding: 0; vertical-align: baseline; }
  .job-title-company { font-weight: 700; color: #262626; }
  .job-title-company .sep { font-weight: 400; font-style: italic; color: #8a8a8a; }
  .job-dates { font-size: 9pt; color: #8a8a8a; white-space: nowrap; text-align: right; }
{% include "_job_duties.css.jinja2" %}
  p.job-duty .duty-mark { color: #3a9d51; }
  .edu-row, .cert-row { display: flex; justify-content: space-between; gap: 12px; margin: 2px 0; }
  .edu-degree { font-weight: 700; }
  .edu-dates { font-size: 9pt; color: #8a8a8a; white-space: nowrap; }
  ul.plain { margin: 4px 0 0; padding-left: 18px; }
  ul.plain li { margin: 2px 0; color: #444; }
  /* Page-break hygiene. Deliberately NOT "break-inside: avoid" on the
     whole .job block - forcing an entire multi-bullet job to move as one
     unit means the ENTIRE job jumps to the next page the instant it
     doesn't fully fit in whatever space is left, wasting that leftover
     space as a large blank gap. Letting a job's bullet list split
     naturally (like a normal paragraph/list) fills the page properly;
     only the job's header is kept glued to its first bullet (never
     stranded alone with nothing under it), and a single bullet's own
     text is never split mid-sentence. */
  h2.section { break-after: avoid; page-break-after: avoid; }
  .job-header { break-after: avoid; page-break-after: avoid; }
  p.job-duty, ul.plain li { break-inside: avoid; page-break-inside: avoid; }
  p, li { orphans: 3; widows: 3; }
</style>
</head>
<body>
<table class="page-wrap">
  <thead><tr><td class="bar-cell"><div class="accent-bar"></div></td></tr></thead>
  <tbody><tr><td class="content-cell">

  <h1 class="name">{{ resume.contact.name }}</h1>
  {% if resume.experience %}<p class="title">{{ resume.experience[0].title }}</p>{% endif %}
  <p class="contact">
    {% if resume.contact.location %}<span>{{ resume.contact.location }}</span>{% endif %}
    {% if resume.contact.email %}<span>{{ resume.contact.email }}</span>{% endif %}
    {% if resume.contact.phone %}<span>{{ resume.contact.phone }}</span>{% endif %}
    {% if resume.contact.linkedin %}<span>{{ resume.contact.linkedin }}</span>{% endif %}
  </p>

  {% if resume.summary %}
  <h2 class="section">Summary</h2>
  <p class="summary">{{ resume.summary }}</p>
  {% endif %}

  {% set all_skills = resume.skills.languages + resume.skills.backend + resume.skills.frontend + resume.skills.cloud + resume.skills.devops + resume.skills.databases + resume.skills.ai + resume.skills.tools %}
  {% if all_skills %}
  <h2 class="section">Skills</h2>
  <p class="skills-line">{{ all_skills | join(", ") }}</p>
  {% endif %}

  {% if resume.experience %}
  <h2 class="section">Experience</h2>
  {% for job in resume.experience %}
  <div class="job">
    <table class="job-header">
      <tr>
        <td class="job-title-company">{{ job.company }}<span class="sep"> &mdash; {{ job.title }}</span></td>
        <td class="job-dates">{{ job.dates }}</td>
      </tr>
    </table>
    {% include "_job_duties.html.jinja2" %}
  </div>
  {% endfor %}
  {% endif %}

  {% if resume.education %}
  <h2 class="section">Education</h2>
  {% for edu in resume.education %}
  <div class="edu-row">
    <span class="edu-degree">{{ edu.degree }}{% if edu.institution %} &mdash; {{ edu.institution }}{% endif %}</span>
    <span class="edu-dates">{{ edu.dates }}</span>
  </div>
  {% endfor %}
  {% endif %}

  {% if resume.certifications %}
  <h2 class="section">Certifications</h2>
  <ul class="plain">{% for line in resume.certifications %}<li>{{ line }}</li>{% endfor %}</ul>
  {% endif %}

  {% if resume.languages %}
  <h2 class="section">Languages</h2>
  <ul class="plain">{% for line in resume.languages %}<li>{{ line }}</li>{% endfor %}</ul>
  {% endif %}

  </td></tr></tbody>
</table>
</body>
</html>
