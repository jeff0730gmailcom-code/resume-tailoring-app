# OpenAI API credentials
OPENAI_API_KEY=sk-your-api-key-here
# gpt-4o-mini (non-reasoning) is the recommended default: ~1-4s per call on
# this app's compact, pre-computed-skill-match prompt, vs. 8-230+s measured
# with reasoning-family models (gpt-5*, o1/o3/o4*) even at minimal
# reasoning effort. Only override this if you've verified the latency
# trade-off is acceptable for your volume.
OPENAI_MODEL=gpt-5-mini
# Reasoning effort for gpt-5* / o-series: minimal keeps latency down.
OPENAI_REASONING_EFFORT=minimal
OPENAI_REQUEST_TIMEOUT_SECONDS=120.0
OPENAI_CONNECT_TIMEOUT_SECONDS=10.0
OPENAI_MAX_RETRIES=1
# Shared reasoning + visible-output budget for gpt-5-mini (raise if
# structured responses come back empty/truncated).
OPENAI_MAX_OUTPUT_TOKENS=4000
TAILORING_TIME_BUDGET_SECONDS=90.0
TAILORING_FULL_REWRITE_JOBS=2
TAILORING_FULL_JOB_MAX_BULLETS=4
TAILORING_SECONDARY_JOB_MAX_BULLETS=2

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Temporary file storage directory (created automatically if missing)
TEMP_STORAGE_DIR=temp

# SQLite database location (created automatically on startup).
# Local default is backend/data/app.db. On Railway, attach a volume and
# the app stores app.db on that volume automatically so deploys keep
# users and activity. You can also set an absolute DATABASE_DIR.
DATABASE_DIR=data
DATABASE_FILENAME=app.db

# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# ATS keyword-match tuning: target score (0-1) and max AI refinement passes.
# Both default to 0 so a tailor request makes EXACTLY ONE OpenAI call - each
# pass above 0 is a full extra sequential OpenAI round trip. Raise only as
# an opt-in latency-for-score trade.
ATS_SCORE_TARGET=0.95
ATS_MAX_REFINE_ATTEMPTS=0

# Tailoring mode: "accurate" (default), "aggressive", or "aggressive_match".
# All three are 100% truthful and make exactly one OpenAI call by default
# (required for the <5s target). "aggressive_match" is the strongest:
# full-resume rewrite permission, widest transferable-skill search, and a
# deterministic (non-AI) Skills-section top-up after generation - see
# app/core/config.py and resume_validator.close_ats_gaps. An optional
# refine loop exists via AGGRESSIVE_MATCH_ATS_MAX_REFINE_ATTEMPTS but
# stays at 0 for speed.
TAILORING_MODE=accurate
AGGRESSIVE_ATS_MAX_REFINE_ATTEMPTS=0
# 0 = exactly one OpenAI call (required for <5s). Raise to 1 only if you
# need to trade latency for a higher hit rate on large skill gaps.
AGGRESSIVE_MATCH_ATS_MAX_REFINE_ATTEMPTS=0

# Auth (Google Sign-In + email/password). Generate a long random JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
